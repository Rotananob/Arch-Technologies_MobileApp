datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum NotificationType {
  EVENT_ANNOUNCEMENT
  EVENT_REMINDER
  REGISTRATION_CONFIRMED
  EVENT_UPDATE
  GENERAL
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  passwordHash     String
  fullName         String
  studentId        String?
  department       String?
  phoneNumber      String?
  role             Role                   @default(STUDENT)
  avatarUrl        String?
  refreshTokenHash String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  registrations    EventRegistration[]
  savedEvents      SavedEvent[]
  notifications    Notification[]
  preferences      NotificationPreference?

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  nameKh      String
  slug        String   @unique
  icon        String
  colorHex    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      Event[]

  @@map("categories")
}

model Event {
  id                     String              @id @default(uuid())
  title                  String
  titleKh                String?
  description            String
  descriptionKh          String?
  categoryId             String
  location               String
  isOnline               Boolean             @default(false)
  meetingUrl             String?
  organizer              String
  imageUrl               String?
  startDate              DateTime
  endDate                DateTime
  isRegistrationRequired Boolean             @default(false)
  maxCapacity            Int?
  isPublished            Boolean             @default(true)
  isFeatured             Boolean             @default(false)
  priorityAlert          Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  category               Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  registrations          EventRegistration[]
  savedEvents            SavedEvent[]
  notifications          Notification[]

  @@index([categoryId])
  @@index([startDate])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("events")
}

model EventRegistration {
  id        String             @id @default(uuid())
  userId    String
  eventId   String
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_registrations")
}

model SavedEvent {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("saved_events")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  eventId   String?
  title     String
  titleKh   String?
  message   String
  messageKh String?
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  eventAnnouncements  Boolean  @default(true)
  upcomingReminders   Boolean  @default(true)
  registrationUpdates Boolean  @default(true)
  generalAlerts       Boolean  @default(true)
  fcmToken            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
